# Required for live Qwen decisions. Keep this file secret; never commit .env.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# Required for dashboard REST actions. Use a long private PIN.
DASHBOARD_PIN=

# MT5 and service settings
MT5_SYMBOLS=EURUSD,XAUUSD,Volatility 75 Index,Boom 1000 Index,Crash 1000 Index
UNIVERSALAI_DB=accounts.db
HOST=127.0.0.1
PORT=8000
ENABLE_BACKGROUND_SCANNER=0
SCAN_INTERVAL_SECONDS=60
