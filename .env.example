# Signal providers. Keep API keys in your local .env and never commit them.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_MAX_COMPLETION_TOKENS=1024
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Fallback when Groq is unconfigured or its request fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Required for license administration. Use a long private PIN; never commit .env.
ADMIN_PIN=

# MT5 and service settings
MT5_SYMBOLS=EURUSD,XAUUSD,Volatility 75 Index,Boom 1000 Index,Crash 1000 Index
UNIVERSALAI_DB=accounts.db
HOST=127.0.0.1
PORT=8000
ENABLE_BACKGROUND_SCANNER=0
SCAN_INTERVAL_SECONDS=60
